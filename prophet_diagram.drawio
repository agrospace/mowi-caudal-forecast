        <mxCell id="3jqhEcKQW0qcksOgG0Pr-23" value="&lt;span class=&quot;inline-math ProseMirror-selectednode&quot; draggable=&quot;true&quot;&gt;&lt;span class=&quot;ProseMirror-widget&quot;&gt;&lt;span class=&quot;katex&quot;&gt;&lt;span class=&quot;katex-mathml&quot;&gt;&lt;math xmlns=&quot;http://www.w3.org/1998/Math/MathML&quot;&gt;&lt;mrow&gt;&lt;mi&gt;$$y(t) =&amp;nbsp; g(t) + s(t) + h(t) + X(t)\beta + \epsilon_t$$&lt;/mi&gt;&lt;/mrow&gt;&lt;/math&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=23;" vertex="1" parent="1">
