        <mxCell id="3jqhEcKQW0qcksOgG0Pr-29" value="Se representa como una serie&lt;div&gt;&amp;nbsp;de Fourier con periodo P&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;" vertex="1" parent="1">
